---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getToolsByCategory, CATEGORIES, TOOLS } from '../../lib/tools';
const totalTools = TOOLS.length;
---
<BaseLayout title="All Tools" description="Browse all free online tools for PDF, Word, images, audio, video, and links. Every tool processes files locally in your browser." canonicalPath="/tools/">
  <main>
    <div class="mx-auto max-w-6xl px-4 pt-6">
      <Breadcrumb items={[{ label: 'Tools' }]} />
    </div>
    <section class="mx-auto max-w-6xl px-4 py-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">All tools</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600">
        {totalTools} free tools organized by category. Everything runs in your browser — no uploads, no sign-up, no limits.
      </p>
    </section>

    <AdSlot />

    {CATEGORIES.map((c) => (
      <section class="mx-auto max-w-6xl px-4 pb-10">
        <div id={c.id} class="scroll-mt-24">
          <ToolCard title={`${c.label} tools`} tools={getToolsByCategory([c.id])} />
        </div>
      </section>
    ))}
  </main>
</BaseLayout>