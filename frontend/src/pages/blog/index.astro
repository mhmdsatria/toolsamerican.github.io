---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { siteName } from '../../config/site.config.json';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const categories = [...new Set(posts.map((p) => p.data.category))];
---
<BlogLayout title={`Blog — ${siteName}`} description="Guides and tutorials on working with PDF, Word, images, audio, and video — all free, all processed locally in your browser." canonicalPath="/blog/">
  <header>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Blog</h1>
    <p class="mt-3 text-lg text-slate-600">Practical guides, tips, and tutorials for working with documents, images, and media.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {categories.map((c) => (
        <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 ring-1 ring-brand-100">{c}</span>
      ))}
    </div>
  </header>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="group flex flex-col rounded-2xl border border-slate-200 p-6 transition-shadow hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{post.data.category}</p>
        <h2 class="mt-2 text-xl font-bold leading-snug text-slate-900 group-hover:text-brand-700">{post.data.title}</h2>
        <p class="mt-2 line-clamp-3 text-sm text-slate-600">{post.data.description}</p>
        <div class="mt-4 flex items-center gap-3 text-xs text-slate-400">
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.readingTime} min read</span>
        </div>
      </a>
    ))}
  </div>
</BlogLayout>