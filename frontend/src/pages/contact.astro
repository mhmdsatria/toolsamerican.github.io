---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteName } from '../config/site.config.json';
---
<BaseLayout title="Contact" description={`Contact ${siteName} — get in touch about tool suggestions, bug reports, or advertising inquiries.`} canonicalPath="/contact/">
  <main>
    <div class="mx-auto max-w-6xl px-4 pt-6">
      <Breadcrumb items={[{ label: 'Contact' }]} />
    </div>
    <section class="mx-auto max-w-2xl px-4 py-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Contact</h1>
      <p class="mt-4 text-lg leading-7 text-slate-600">
        Questions, feedback, or ideas for a new tool? We read every message. Because {siteName} has no user accounts,
        the quickest way to reach us is by email.
      </p>

      <a href="mailto:contact@toolsamerican.github.io" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700">
        ✉️ contact@toolsamerican.github.io
      </a>

      <h2 class="mt-10 text-xl font-bold text-slate-900">What we are happy to hear about</h2>
      <ul class="mt-3 list-disc space-y-2 pl-6 text-slate-700">
        <li>Tool suggestions — what should we build next?</li>
        <li>Bug reports — include the tool name and your browser version if possible.</li>
        <li>Accuracy feedback on blog guides.</li>
        <li>Partnership or advertising inquiries.</li>
      </ul>

      <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-bold text-slate-900">Before you email</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Every tool processes files locally in your browser, so we can never recover a file you lost —
          please do not attach documents to support emails. If a download did not start, try again in a
          recent version of Chrome, Edge, Firefox, or Safari.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>