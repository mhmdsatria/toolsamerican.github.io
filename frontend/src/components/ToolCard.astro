---
import { getToolsByCategory } from '../lib/tools';

interface Props {
  tools?: Array<{ slug: string; path: string; title: string; tagline: string; icon: string }>;
  category?: string;
  limit?: number;
  exclude?: string;
  title?: string;
}
const { tools: toolList, category, limit, exclude, title = category ? `${category} tools` : 'All tools' } = Astro.props;

let tools = toolList ?? (category ? getToolsByCategory([category]) : getToolsByCategory());
if (exclude) tools = tools.filter((t) => t.slug !== exclude);
if (limit) tools = tools.slice(0, limit);
---
<section class="not-prose" aria-label={title}>
  <h2 class="mb-5 text-2xl font-bold text-slate-900">{title}</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((tool) => (
      <a
        href={tool.path}
        class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md hover:border-brand-200"
      >
        <span class="text-3xl" aria-hidden="true">{tool.icon}</span>
        <h3 class="mt-3 font-semibold text-slate-900 group-hover:text-brand-600">{tool.title}</h3>
        <p class="mt-1 text-sm text-slate-600 line-clamp-2">{tool.tagline}</p>
        <span class="mt-3 text-sm font-medium text-brand-600">Open tool →</span>
      </a>
    ))}
  </div>
</section>