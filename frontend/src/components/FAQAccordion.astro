---
interface Faq {
  q: string;
  a: string;
}
interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---
<section aria-label="Frequently asked questions" class="mt-12">
  <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
  <div class="divide-y divide-slate-200 rounded-xl border border-slate-200">
    {items.map((faq) => (
      <details class="group" name="faq">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-slate-800">
          {faq.q}
          <span class="text-slate-400 transition-transform group-open:rotate-45" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </summary>
        <div class="px-5 pb-5 text-sm leading-6 text-slate-600">
          <p>{faq.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>