---
import { siteName } from '../config/site.config.json';
const links = [
  { href: '/tools/', label: 'All Tools' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3" aria-label="Main navigation">
    <a href="/" class="flex items-center gap-2" aria-label={`${siteName} home`}>
      <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7" loading="eager" />
      <span class="text-lg font-bold tracking-tight text-brand-800">{siteName}</span>
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPath === link.href || (link.href !== '/tools/' && currentPath.startsWith(link.href)) ? 'page' : undefined}
            class={"text-sm font-medium transition-colors " + (currentPath.startsWith(link.href)
              ? "text-brand-600"
              : "text-slate-600 hover:text-brand-600")}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 text-slate-600 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="sr-only">Open menu</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-100 px-4 pb-3 md:hidden" data-mobile-menu>
    {links.map((link) => (
      <a href={link.href} class="block py-2 text-sm font-medium text-slate-700" data-mobile-link>{link.label}</a>
    ))}
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }
  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>