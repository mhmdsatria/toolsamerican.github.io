---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  post?: import('astro:content').CollectionEntry<'blog'> | null;
  title: string;
  description?: string;
  canonicalPath?: string;
}
const { post, title, description, canonicalPath } = Astro.props;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType={post ? 'article' : 'website'} ogImage={post?.data.cover ?? undefined}>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    {post ? (
      <Breadcrumb items={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title }]} />
    ) : (
      <Breadcrumb items={[{ label: 'Blog' }]} />
    )}
  </div>

  <main class="mx-auto max-w-3xl px-4 pt-2">
    {post && (
      <header class="not-prose">
        <p class="mb-2 text-sm font-medium text-brand-600">{post.data.category}</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{post.data.title}</h1>
        <div class="mt-4 flex items-center gap-3 text-sm text-slate-500">
          <span>{post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.readingTime} min read</span>
        </div>
      </header>
    )}

    <AdSlot />

    <div class="mt-6">
      <slot />
    </div>

    <AdSlot />
  </main>
</BaseLayout>